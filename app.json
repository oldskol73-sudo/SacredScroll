{
  "expo": {
    "name": "Sacred Scroll",
    "slug": "tsp-bible-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/bible/icon.png",
    "scheme": "expotemplate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.twelvescentspublishing.sacredscroll",
      "buildNumber": "01",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.twelvescentspublishing.sacredscroll"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5ECD6"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withPodsDeploymentTarget",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
